{
  "expo": {
    "name": "Tend",
    "slug": "tend",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tend.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0d21",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tend.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#0a0d21",
          "dark": {
            "backgroundColor": "#0a0d21"
          }
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "sounds": [
            "./assets/sounds/focus_bell.wav"
          ],
          "color": "#9f88ff"
        }
      ],
      "expo-sharing",
      "./plugins/withLocalCleartext",
      "expo-iap",
      "expo-web-browser"
    ],
    "scheme": "tend",
    "backgroundColor": "#0a0d21",
    "experiments": {
      "typedRoutes": true
    }
  }
}

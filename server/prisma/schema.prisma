// Portable across SQLite (dev) and Postgres: no enums, no native JSON columns,
// no SQLite-only attributes. JSON-shaped fields are stored as TEXT holding JSON
// and (de)serialised in src/sync/collections.ts.
//
// Epoch-millisecond timestamps are `Float` (a double on both engines), which
// round-trips any JS number exactly without BigInt conversion.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id
  email        String   @unique
  name         String
  passwordHash String
  createdAt    Float
  /// Per-user monotonically increasing revision; bumped once per accepted sync write.
  rev          Int      @default(0)
  /// 'user' | 'admin'
  role         String   @default("user")
  /// Set when an admin disables the account; disabled users cannot authenticate.
  disabledAt   Float?
  /// Last successful /v1/sync (used for "active" stats).
  lastSyncAt   Float?
  /// Permanent friend-invite code (8 chars, stored without the dash). Generated lazily.
  inviteCode      String? @unique
  /// Social privacy: when false, the friend card's `habits` are stripped before friends see it.
  shareHabitNames Boolean @default(false)

  refreshTokens RefreshToken[]
  entitlements  Entitlement[]
  profile       Profile?
  habits        Habit[]
  habitLogs     HabitLog[]
  tasks         Task[]
  focusSessions FocusSession[]
  moodLogs      MoodLog[]
  badges        BadgeState[]

  invitesSent      InviteRedemption[] @relation("InviteInviter")
  invitedVia       InviteRedemption?  @relation("InviteInvitee")
  friendshipsA     Friendship[]       @relation("FriendshipA")
  friendshipsB     Friendship[]       @relation("FriendshipB")
  requestsSent     FriendRequest[]    @relation("RequestFrom")
  requestsReceived FriendRequest[]    @relation("RequestTo")
  friendCard       FriendCard?
  inbox            InboxItem[]        @relation("InboxRecipient")
  inboxSent        InboxItem[]        @relation("InboxSender")
  blocksMade       Block[]            @relation("BlockBlocker")
  blocksReceived   Block[]            @relation("BlockBlocked")
  reportsMade      Report[]           @relation("ReportReporter")
  reportsReceived  Report[]           @relation("ReportTarget")
  pushTokens       PushToken[]
}

model RefreshToken {
  id         String  @id
  userId     String
  /// Tokens issued by rotation from the same login share a family.
  familyId   String
  /// SHA-256 of the opaque token; the raw token is never stored.
  tokenHash  String  @unique
  createdAt  Float
  expiresAt  Float
  revokedAt  Float?
  replacedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Profile {
  userId            String  @id
  name              String
  xp                Float
  themeId           String
  mode              String
  prefs             String
  notificationPrefs String
  streakProtection  String
  onboardedAt       Float?
  updatedAt         Float
  rev               Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, rev])
}

model Habit {
  userId    String
  id        String
  name      String
  icon      String
  hue       Float
  category  String
  frequency String
  goal      Float
  unit      String
  step      Float
  timeOfDay String
  reminder  String?
  notes     String?
  createdAt Float
  order     Float
  updatedAt Float
  deleted   Boolean
  rev       Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, rev])
}

model HabitLog {
  userId      String
  id          String
  habitId     String
  date        String
  count       Float
  completedAt Float?
  updatedAt   Float
  deleted     Boolean
  rev         Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, rev])
}

model Task {
  userId        String
  id            String
  title         String
  due           String?
  time          String?
  priority      String
  done          Boolean
  doneAt        Float?
  habitId       String?
  focusSessions Float
  list          String
  createdAt     Float
  updatedAt     Float
  deleted       Boolean
  rev           Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, rev])
}

model FocusSession {
  userId    String
  id        String
  start     Float
  end       Float
  mode      String
  minutes   Float
  taskId    String?
  completed Boolean
  updatedAt Float
  deleted   Boolean
  rev       Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, rev])
}

model MoodLog {
  userId    String
  id        String
  date      String
  mood      String
  tags      String
  note      String?
  loggedAt  Float
  updatedAt Float
  deleted   Boolean
  rev       Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, rev])
}

model BadgeState {
  userId     String
  id         String
  unlockedAt Float?
  progress   Float
  updatedAt  Float
  deleted    Boolean
  rev        Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, rev])
}

/// Grants Plus for a period. See docs/API.md (v1.1).
model Entitlement {
  id            String  @id
  userId        String
  /// 'play_subscription' | 'play_lifetime' | 'admin' | 'trial'
  source        String
  /// 'plus' | 'plus_lifetime' | null
  productId     String?
  /// 'monthly' | 'yearly' | null
  basePlanId    String?
  /// 'active' | 'grace' | 'on_hold' | 'paused' | 'canceled' | 'expired' | 'revoked' | 'refunded'
  status        String
  startsAt      Float
  /// null = lifetime
  expiresAt     Float?
  autoRenew     Boolean @default(false)
  note          String?
  grantedBy     String?
  /// Google Play purchase token (Play sources only).
  purchaseToken String? @unique
  createdAt     Float
  updatedAt     Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// One row per admin write. `details` is JSON stored as TEXT.
model AuditLog {
  id           String  @id
  adminId      String
  action       String
  targetUserId String?
  details      String
  createdAt    Float

  @@index([createdAt])
}

// ---- v1.2 social (see docs/API.md) -------------------------------------------------------
// Every social row references its users with ON DELETE CASCADE.

/// One row per account created with someone's invite code (also the invite-reward ledger).
model InviteRedemption {
  id                   String  @id
  inviterId            String
  /// A user can join with at most one code.
  inviteeId            String  @unique
  code                 String
  /// Whether both sides got the 7-day Plus reward (false once the inviter hit the yearly cap).
  rewarded             Boolean
  inviterEntitlementId String?
  inviteeEntitlementId String?
  createdAt            Float

  inviter User @relation("InviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("InviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviterId, createdAt])
  @@index([createdAt])
}

/// An accepted friendship, stored once per pair in canonical order (userAId < userBId).
model Friendship {
  userAId   String
  userBId   String
  createdAt Float

  userA User @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@id([userAId, userBId])
  @@index([userBId])
}

/// A pending friend request. Accepting, declining or cancelling deletes the row.
model FriendRequest {
  id        String @id
  fromId    String
  toId      String
  createdAt Float

  from User @relation("RequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("RequestTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
}

/// The owner-published friend card; `data` is the validated FriendCard as JSON TEXT.
model FriendCard {
  userId    String @id
  data      String
  updatedAt Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Social inbox. kind: 'nudge' | 'cheer' | 'friend_request' | 'friend_accepted' | 'invite_joined'.
model InboxItem {
  id        String  @id
  /// Recipient.
  userId    String
  fromId    String
  kind      String
  /// Preset message key for nudges/cheers.
  message   String?
  createdAt Float
  readAt    Float?

  user User @relation("InboxRecipient", fields: [userId], references: [id], onDelete: Cascade)
  from User @relation("InboxSender", fields: [fromId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([fromId, userId, kind, createdAt])
  @@index([kind, createdAt])
}

model Block {
  blockerId String
  blockedId String
  createdAt Float

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id             String  @id
  reporterId     String
  targetId       String
  /// 'spam' | 'harassment' | 'inappropriate' | 'other'
  reason         String
  details        String?
  /// 'open' | 'resolved'
  status         String  @default("open")
  createdAt      Float
  resolvedAt     Float?
  resolvedBy     String?
  resolutionNote String?

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target   User @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([targetId])
}

/// A device push token. Keyed by the token so a device that switches accounts moves with it.
model PushToken {
  token     String @id
  userId    String
  /// 'android' | 'ios'
  platform  String
  /// 'fcm' | 'expo'
  kind      String
  createdAt Float
  updatedAt Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

# SQLite file, relative to this directory (server/). For Postgres see README.
DATABASE_URL="file:./dev.db"
# At least 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-of-32-chars-or-more"
PORT=4000
# Comma-separated list of allowed origins, or * for any.
CORS_ORIGIN="*"

# ---- Plus / Google Play Billing (v1.1) ----
# Android application id the Play purchases belong to.
GOOGLE_PLAY_PACKAGE_NAME="com.tend.app"
# Service-account key with access to the Play Console app (Android Publisher API).
# Either the raw JSON on one line, or a path to the .json key file. Leave empty to
# disable Google verification (verify then answers 503 BILLING_NOT_CONFIGURED).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
# Shared secret for the Pub/Sub push endpoint: .../v1/billing/google/rtdn?token=<this>.
# Leave empty to reject all RTDN pushes. Generate like JWT_SECRET.
GOOGLE_RTDN_SECRET=""
# Dev only: accept purchase tokens "fake:<monthly|yearly|lifetime>:<random>" without Google.
# The server refuses to start with this on when NODE_ENV=production.
BILLING_FAKE=false
# List prices (INR) used for the admin revenue estimate.
PRICE_MONTHLY_INR=99
PRICE_YEARLY_INR=699
PRICE_LIFETIME_INR=1999

# ---- Friends / push (v1.2) ----
# Firebase service-account key (Project settings -> Service accounts -> Generate new private key).
# Either the raw JSON on one line, or a path to the .json key file. The FCM project id is read
# from it. Leave empty to skip pushes (the in-app social inbox still works).
FIREBASE_SERVICE_ACCOUNT_JSON=""
